{
    "name": "juanoecr/stateful-chunking-upload",
    "description": "Resumable chunked file uploads for Laravel: multi-driver session state, staged upload tokens, and SHA-256 integrity verification. For splitting large files for transport, not documents for LLM embeddings.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Juan Guerrero",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0|^4.0",
        "phpstan/phpstan": "^2.2",
        "vimeo/psalm": "6.17.0"
    },
    "autoload": {
        "psr-4": {
            "Juanoecr\\StatefulChunkingUpload\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Juanoecr\\StatefulChunkingUpload\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage --min=90",
        "lint": "pint",
        "lint:test": "pint --test",
        "analyse": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Run the Pest test suite.",
        "test:coverage": "Run the suite with coverage, failing under 90%.",
        "lint": "Fix code style with Pint.",
        "lint:test": "Check code style with Pint (no changes).",
        "analyse": "Run PHPStan static analysis."
    },
    "extra": {
        "laravel": {
            "providers": [
                "Juanoecr\\StatefulChunkingUpload\\Providers\\StatefulChunkingServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
